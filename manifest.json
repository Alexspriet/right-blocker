{
  "manifest_version": 3,
  "name": "On bloque.",
  "version": "0.1.0",
  "description": "Bloque une liste de profils sur X et Instagram, dans les onglets où vous êtes déjà connecté.",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://www.instagram.com/*"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "action": { "default_popup": "src/popup/popup.html", "default_title": "On bloque.", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["src/content/x.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["src/content/instagram.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
